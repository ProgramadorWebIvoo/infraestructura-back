APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dominio del frontend SPA (usado por CORS). En producción: https://<subdominio>.ivoofix.com
FRONTEND_URL=http://localhost:3000

# Auth SPA (Sanctum stateful): dominios desde los que el frontend puede
# autenticar por cookie de sesión en vez de token Bearer. En producción,
# agregar el subdominio real del SPA (ej. app.ivoofix.com) separado por coma.
# Dev (localhost:3000, 127.0.0.1:8000, etc.) ya viene cubierto por el default de Sanctum.
SANCTUM_STATEFUL_DOMAINS=

# Cookie de sesión: en producción, dominio raíz compartido con el frontend
# (ej. .ivoofix.com, con el punto inicial) para que la cookie viaje entre
# subdominios como same-site; y forzar Secure (requiere HTTPS).
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Evaluation
AI_PROVIDER_ORDER=openai,gemini,anthropic
AI_TIMEOUT=60
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
