APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dominio del frontend SPA (usado por CORS). En producción: https://<subdominio>.ivoofix.com
FRONTEND_URL=http://localhost:3000

# Origen adicional permitido en CORS al acceder desde la red local (IP del servidor de dev)
FRONTEND_URL_LAN=http://10.20.16.247:3000

# Auth SPA (Sanctum stateful): dominios desde los que el frontend puede
# autenticar por cookie de sesión en vez de token Bearer. En producción,
# agregar el subdominio real del SPA (ej. app.ivoofix.com) separado por coma.
# Dev (localhost:3000, 127.0.0.1:8000, etc.) ya viene cubierto por el default de Sanctum.
SANCTUM_STATEFUL_DOMAINS=

# Cookie de sesión: en producción, dominio raíz compartido con el frontend
# (ej. .ivoofix.com, con el punto inicial) para que la cookie viaje entre
# subdominios como same-site; y forzar Secure (requiere HTTPS).
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

# En producción, si hay un reverse proxy / load balancer / CDN delante
# (Nginx, Cloudflare, etc. terminando TLS): "*" para confiar en su
# X-Forwarded-Proto y así detectar HTTPS correctamente (cookies Secure, HSTS).
# Dejar vacío si la app es alcanzable directamente sin proxy delante.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=reverb

# Laravel Reverb (WebSocket): reemplaza el polling de notificaciones por
# push instantáneo. REVERB_HOST/PORT/SCHEME son los que ve el navegador
# (dominio público del WS, ej. detrás de un proxy que enruta a
# REVERB_SERVER_PORT); REVERB_SERVER_HOST/PORT son donde el proceso
# `artisan reverb:start` escucha localmente.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: usar un proveedor SMTP real (Gmail con "contraseña de aplicación",
# https://myaccount.google.com/apppasswords, o un transaccional tipo SES/
# Postmark/SendGrid en producción). MAIL_USERNAME y MAIL_FROM_ADDRESS deben
# coincidir. Alternativa sin credenciales para dev: MAIL_MAILER=log (escribe
# el correo en storage/logs/laravel.log en vez de enviarlo). Ver TESTING_GUIDE.md §11.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
